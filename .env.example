HOST=0.0.0.0
PORT=3000

# Fill these fields with the real settings from your email provider.
# Leave them empty to run the website without email delivery; the form will
# clearly report that the administrator needs to configure SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# SMTP_FROM must be an address authorized by your SMTP provider.
SMTP_FROM=
SMTP_TO=

# Optional. Restricts browser submissions to this exact public site origin.
# Example: PUBLIC_ORIGIN=https://autoted.cz
PUBLIC_ORIGIN=
